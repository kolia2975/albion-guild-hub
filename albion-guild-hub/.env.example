# =====================================================================
#  ALBION GUILD HUB — приклад файлу середовища
#  1. Скопіюй цей файл у ".env"           (не .env.example!)
#  2. Заміни всі значення "change_me..." на свої власні
#  3. НІКОЛИ не публікуй справжній .env у git / discord / скріншотах
# =====================================================================

# ---- Загальне ----
NODE_ENV=production
PORT=4000
# Публічна адреса, на якій буде доступний сайт (для CORS/посилань у нотифікаціях)
PUBLIC_URL=http://localhost:4000

# ---- PostgreSQL ----
POSTGRES_USER=albion
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=albion_guild_hub
# Всередині docker-мережі хост бази завжди "db" — не змінюй, якщо не знаєш навіщо
DATABASE_URL=postgresql://albion:change_me_strong_db_password@db:5432/albion_guild_hub

# ---- Авторизація ----
# Довгий випадковий рядок. Згенерувати можна командою:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_super_long_random_secret
JWT_EXPIRES_IN=12h

# Обліковий запис адміністратора, який автоматично створюється
# при першому запуску, якщо таблиця users порожня
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_password

# ---- Discord бот ----
# Створюється на https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Канал, куди бот кидатиме нотифікації (ПКМ на канал -> Copy Channel ID,
# потрібно увімкнути Developer Mode в Discord: Налаштування -> Розширені)
DISCORD_NOTIFY_CHANNEL_ID=
# (опційно) Webhook-урл каналу як запасний спосіб доставки
DISCORD_WEBHOOK_URL=

# ---- Внутрішній зв'язок бот <-> бекенд ----
# Довільний секретний рядок, однаковий і тут, і в bot/.env
BOT_INTERNAL_API_KEY=change_me_internal_bot_key
APP_INTERNAL_URL=http://app:4000

# ---- Albion Online Data Project (публічне API цін ринку) ----
# Сервер для якого підтягувати ціни: europe / americas / asia
AODP_SERVER=europe
